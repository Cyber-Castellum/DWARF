+
+fn live_nonce_override(
+    imported_epoch: Epoch,
+    requested_epoch: Option<Epoch>,
+    active_nonce: Option<&str>,
+    active_epoch: Option<&str>,
+) -> Result<Option<(Epoch, Nonce)>, Box<dyn Error>> {
+    let (active_nonce, active_epoch) = match (active_nonce, active_epoch) {
+        (None, None) => return Ok(None),
+        (Some(active_nonce), Some(active_epoch)) => (active_nonce, active_epoch),
+        _ => return Err("live nonce override requires both active nonce and active epoch".into()),
+    };
+    let active_epoch = active_epoch
+        .parse::<Epoch>()
+        .map_err(|error| format!("invalid live nonce override epoch: {error}"))?;
+    if requested_epoch != Some(active_epoch) {
+        return Err(format!("live nonce override epoch {active_epoch} does not match requested epoch").into());
+    }
+    if imported_epoch.as_u64().checked_add(1) != Some(active_epoch.as_u64()) {
+        return Err(
+            format!("live nonce override epoch {active_epoch} is not adjacent to imported epoch {imported_epoch}").into(),
+        );
+    }
+    let active_nonce = amaru_kernel::parse_nonce(active_nonce)
+        .map_err(|error| format!("invalid live nonce override: {error}"))?;
+    Ok(Some((active_epoch, active_nonce)))
 }
 
+fn live_nonce_override_tail(imported_point: &Point) -> HeaderHash {
+    Hash::from(imported_point)
+}
