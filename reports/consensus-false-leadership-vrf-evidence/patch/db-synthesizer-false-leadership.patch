+-- ---------------------------------------------------------------------------
+-- DWARF false-leadership patch
+--
+-- When DWARF_FALSE_LEADERSHIP is set, we raise the per-era active-slot
+-- coefficient (praosLeaderF / tpraosLeaderF) to ~1 in the consensus config
+-- used to forge and to validate our own forged blocks. This makes the local
+-- forger "win" the VRF leader lottery in (almost) every slot regardless of
+-- its real stake, producing blocks whose VRF proof is valid but whose leader
+-- value is far above the real threshold. Only the leader-value check is
+-- affected: praosRandomnessStabilisationWindow (nonce evolution) is a separate
+-- field and is left untouched, so the forged chain still connects to the real
+-- genesis root and the honest prefix replays consistently.
+--
+-- Served to an honest node (real, low coefficient), each such block must be
+-- rejected as VRFLeaderValueTooBig. A node that accepts it is not enforcing
+-- the leadership threshold -> any-stake block forgery.
+-- ---------------------------------------------------------------------------
+
+{-# NOINLINE falseLeadership #-}
+falseLeadership :: Bool
+falseLeadership =
+    unsafePerformIO (maybe False (const True) <$> lookupEnv "DWARF_FALSE_LEADERSHIP")
+
+hiF :: SL.ActiveSlotCoeff
+hiF = SL.mkActiveSlotCoeff (fromMaybe (error "hiF: bad coeff") (SL.boundRational (99 % 100)))
+
+bumpLeaderF ::
+     TopLevelConfig (CardanoBlock StandardCrypto)
+  -> TopLevelConfig (CardanoBlock StandardCrypto)
+bumpLeaderF cfg = cfg { topLevelConfigProtocol = hfc' }
+  where
+    hfc  = topLevelConfigProtocol cfg
+    hfc' = hfc
+      { hardForkConsensusConfigPerEra =
+          PerEraConsensusConfig
+            (bumpNP (getPerEraConsensusConfig (hardForkConsensusConfigPerEra hfc)))
+      }
+
+bumpNP ::
+     NP WrapPartialConsensusConfig (CardanoEras StandardCrypto)
+  -> NP WrapPartialConsensusConfig (CardanoEras StandardCrypto)
+bumpNP (byron :* sh :* al :* ma :* alo :* ba :* co :* Nil) =
+       byron
+    :* wT sh :* wT al :* wT ma :* wT alo
+    :* wP ba :* wP co
+    :* Nil
+  where
+    wT (WrapPartialConsensusConfig pp) =
+        WrapPartialConsensusConfig pp { tpraosLeaderF = hiF }
+    wP (WrapPartialConsensusConfig pp) =
+        WrapPartialConsensusConfig pp { praosLeaderF = hiF }
