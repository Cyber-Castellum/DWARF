+// DWARF patch: build the bootstrap manifest from local `.tar.zst` archives + a local era-history,
+// for custom testnets that are not on S3 and have no bundled era-history.
+fn local_bootstrap_snapshots(snapshots_dir: &Path) -> Result<Option<Vec<Snapshot>>, Box<dyn Error>> {
+    let era_path = match std::env::var("AMARU_ERA_HISTORY") {
+        Ok(p) => p,
+        Err(_) => return Ok(None),
+    };
+    let entries = match std::fs::read_dir(snapshots_dir) {
+        Ok(e) => e,
+        Err(_) => return Ok(None),
+    };
+    let era_history = EraHistory::load(Path::new(&era_path))
+        .map_err(|err| format!("failed to load AMARU_ERA_HISTORY {era_path}: {err:?}"))?;
+    let mut snapshots = Vec::new();
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if is_snapshot_archive_file(&path) {
+            if let Some(fname) = path.file_name().and_then(|s| s.to_str()) {
+                let point = fname.trim_end_matches(".tar.zst").to_string();
+                let slot = parse_slot_from_point(&point)?;
+                let epoch = era_history.slot_to_epoch_unchecked_horizon(Slot::from(slot))?;
+                snapshots.push(Snapshot { epoch, point, key: String::new() });
+            }
+        }
+    }
+    if snapshots.len() >= 3 {
+        Ok(Some(snapshots))
+    } else {
+        Ok(None)
+    }
+}
