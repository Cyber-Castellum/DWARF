# DWARF delivery — example environment file.
#
# Copy to `.env` in the package root to override deployment defaults. Every
# value here is OPTIONAL: with no `.env` at all, `delivery/scripts/deploy.sh`
# brings up the dashboard on 0.0.0.0:8787 with sensible defaults. The delivery
# scripts source this file automatically before running Docker Compose.
#
#   cp .env.example .env
#   # edit as needed, then:
#   delivery/scripts/deploy.sh
#
# NOTE: `.env` is gitignored because it may hold secrets (PATs, Antithesis
# credentials). Keep real secrets out of `.env.example`.

# ─── Core dashboard (most operators only need DWARF_DASHBOARD_PORT) ──────────
# Container image tag built by delivery/scripts/build-image.sh
#DWARF_IMAGE=dwarf/framework:current
# Container name
#DWARF_CONTAINER_NAME=dwarf-fw
# Bind address — use 127.0.0.1 for loopback-only access
#DWARF_DASHBOARD_BIND=0.0.0.0
# Host port for the dashboard
#DWARF_DASHBOARD_PORT=8787
# Absolute path to the runtime data root (runs/state/bundles). Defaults to
# the package-local ./var created by delivery/scripts/install.sh
#DWARF_RUNTIME_ROOT=/absolute/path/to/var
# Dashboard access token
#ADA2_DWARF_TOKEN=dwarf

# ─── Optional SSH fan-out (only if a scenario drives another host) ───────────
# Default: empty placeholder files under <runtime-root>/state created by
# install.sh — no fan-out configured. Point these at real files to enable it.
#DWARF_SSH_KEY_PATH=/absolute/path/to/deploy_key
#DWARF_SSH_KNOWN_HOSTS=/absolute/path/to/known_hosts

# ─── Optional Moog / Antithesis launch (live campaigns only) ────────────────
# Not needed for local fuzzing or the dashboard. Configure only to launch live
# Antithesis campaigns through Moog. These can also be entered in the dashboard
# setup form at /operate/config and saved to var/state/config.yaml.
#DWARF_MOOG_ENABLED=
#DWARF_MOOG_BOOTSTRAP=off            # off | plan | approve
#DWARF_MOOG_BOOTSTRAP_APPROVE=0      # must be 1 when DWARF_MOOG_BOOTSTRAP=approve
#MOOG_GITHUB_USER=
#MOOG_GITHUB_REPO=
#MOOG_GITHUB_PAT=                    # secret — do not commit
#MOOG_TARGET_DIRECTORY=
#MOOG_TARGET_COMMIT=
#MOOG_ANTITHESIS_LAUNCH_URL=
#MOOG_ANTITHESIS_USER=
#MOOG_ANTITHESIS_PASSWORD=           # secret — do not commit
#MOOG_REGISTRY=
#MOOG_ANTITHESIS_API_KEY=            # secret — do not commit
#MOOG_AGENT_EMAIL_USER=
#MOOG_AGENT_EMAIL_PASSWORD=          # secret — do not commit
