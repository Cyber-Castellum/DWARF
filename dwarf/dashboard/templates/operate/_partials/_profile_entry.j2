<article class="profile-entry" id="{{ entry.id }}">
  <span class="eyebrow">{{ entry.node_type }}</span>
  <h2 class="profile-entry__label">{{ entry.label }}</h2>
  <p class="profile-entry__id"><code>{{ entry.id }}</code></p>
  <dl class="profile-entry__fields">
    <div>
      <dt class="profile-entry__field-key">Nodes</dt>
      <dd class="profile-entry__field-value">
        {% if entry.node_type == 'mixed' %}
          {{ entry.node_count }} Haskell + {{ entry.amaru_node_count }} Amaru
        {% elif entry.node_type == 'amaru' %}
          {{ entry.amaru_node_count }} Amaru
        {% else %}
          {{ entry.node_count }} Haskell
        {% endif %}
      </dd>
    </div>
    <div>
      <dt class="profile-entry__field-key">Network magic</dt>
      <dd class="profile-entry__field-value"><code>{{ entry.network_magic }}</code></dd>
    </div>
    <div>
      <dt class="profile-entry__field-key">Peer sharing</dt>
      <dd class="profile-entry__field-value">{{ 'enabled' if entry.peer_sharing else 'disabled' }}</dd>
    </div>
    {% if entry.upstream_peer_address %}
    <div>
      <dt class="profile-entry__field-key">Upstream peer</dt>
      <dd class="profile-entry__field-value"><code>{{ entry.upstream_peer_address }}</code></dd>
    </div>
    {% endif %}
    {% if entry.listen_address %}
    <div>
      <dt class="profile-entry__field-key">Listen address</dt>
      <dd class="profile-entry__field-value"><code>{{ entry.listen_address }}</code></dd>
    </div>
    {% endif %}
    {% if entry.amaru_network %}
    <div>
      <dt class="profile-entry__field-key">Amaru network</dt>
      <dd class="profile-entry__field-value">{{ entry.amaru_network }}</dd>
    </div>
    {% endif %}
  </dl>
  <p class="profile-entry__anchor">
    <span class="eyebrow">Runtime root</span>
    <code>{{ entry.remote_runtime_root }}</code>
  </p>
  <div class="profile-entry__deploy" style="margin-top:12px">
    <span class="eyebrow">Deploy</span>
    {% if shim_enabled %}
    <p class="page-subhero" style="margin:2px 0 6px;font-size:.72rem">Deploys this profile to the substrate host over the restricted control channel. Output streams below.</p>
    <button type="button" class="profile-entry__deploy-btn" data-profile="{{ entry.id }}" onclick="runDeploy(this)" style="background:var(--accent);color:var(--obsidian-0);border:none;border-radius:8px;padding:8px 18px;font-weight:700;font-size:.82rem;cursor:pointer">Deploy</button>
    <pre class="profile-entry__deploy-out" id="deploy-out-{{ entry.id }}" style="display:none;margin:10px 0 0;background:#04060a;border:1px solid var(--rule);border-radius:10px;padding:12px 14px;max-height:280px;overflow:auto;white-space:pre-wrap;word-break:break-word;font-family:var(--font-mono);font-size:.76rem;color:#cfeaea"></pre>
    <p class="page-subhero" style="margin:8px 0 0;font-size:.7rem;color:var(--ink-muted)">Or run manually: <code>cardano-profile deploy {{ entry.id }}</code></p>
    {% else %}
    <p class="page-subhero" style="margin:2px 0 6px;font-size:.72rem">Spins up a devnet on the substrate host. The control channel is not provisioned on this deployment, so copy-paste and run on the host:</p>
    <div style="display:flex;gap:8px;align-items:stretch">
      <code class="profile-entry__deploy-cmd" style="flex:1;background:#04060a;border:1px solid var(--rule);border-radius:8px;padding:8px 11px;font-family:var(--font-mono);font-size:.78rem;color:#cfeaea;overflow-x:auto;white-space:nowrap">cardano-profile deploy {{ entry.id }}</code>
      <button type="button" class="profile-entry__deploy-copy" data-cmd="cardano-profile deploy {{ entry.id }}" onclick="copyDeploy(this)" style="background:var(--accent);color:var(--obsidian-0);border:none;border-radius:8px;padding:8px 14px;font-weight:700;font-size:.78rem;cursor:pointer;white-space:nowrap">Copy</button>
    </div>
    {% endif %}
  </div>
</article>
