{% extends "_base.j2" %}
{% block main %}
<span class="eyebrow">Learn</span>
<h1>Status</h1>
<p>Deployed source provenance, live catalog inventory, findings, and available repository status. Combined with <a href="/learn/coverage">coverage</a>, this identifies exactly what this dashboard can run.</p>

<section class="status-section" id="deployed-source">
  <span class="eyebrow">Deployed source</span>
  <p><strong>{{ deployed.scenario_count }} scenarios</strong> and <strong>{{ deployed.primitive_count }} primitives</strong> are readable from the live catalogs.</p>
  <p class="coverage-matrix__anchor">
    <span class="eyebrow">Public revision</span>
    {% if deployed.revision_known %}<a href="{{ deployed.repository }}/commit/{{ deployed.revision }}"><code>{{ deployed.revision }}</code></a>{% else %}<code>unknown</code> — rebuild with <code>DWARF_SOURCE_REVISION</code>{% endif %}
  </p>
</section>

{% if data_source_caveat %}
<aside class="data-source-caveat">
  <span class="eyebrow">Data source caveat</span>
  Git history is not packaged in the runtime image. File-backed findings and live catalogs are current for the deployed revision; commit history and top-level status notes are unavailable here.
</aside>
{% endif %}

<hr class="hairline">

<section class="status-section" id="current-phase">
  <span class="eyebrow">Current phase</span>
  {% if phase.needs_source %}
  <p class="empty-section-statement">
    needs source
    <span class="empty-section-statement__cite">no currentstatus-*.md found in repo root</span>
  </p>
  {% else %}
  <p>{{ phase.title }} — last modified {{ phase.last_modified }}.</p>
  <p class="coverage-matrix__anchor">
    <span class="eyebrow">Anchor</span>
    <code>{{ phase.anchor_path }}</code>
  </p>
  {% endif %}
</section>
<hr class="hairline">

<section class="status-section" id="recent-work">
  <span class="eyebrow">Recent work</span>
  {% if recent_commits %}
  <p>Last {{ recent_commits|length }} feature commits on <code>main</code>. Dashboard scaffolding (<code>plan:</code> docs and any <code>(dashboard)</code>-scoped commit) is filtered out by commit-message pattern.</p>
  <ul class="recent-work-list">
    {% for row in recent_commits %}
    <li class="recent-work-row">
      <code class="recent-work-row__hash">{{ row.hash }}</code>
      <span class="recent-work-row__msg">{{ row.message }}</span>
      <span class="recent-work-row__date">{{ row.date }}</span>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty-section-statement">
    Commit history is not available in this runtime image.
    <span class="empty-section-statement__cite">use the public revision above for canonical history</span>
  </p>
  {% endif %}
  {% if recent_commits %}<p class="coverage-matrix__anchor">
    <span class="eyebrow">Anchor</span>
    <code>git log main --oneline -n20</code>
  </p>{% endif %}
</section>
<hr class="hairline">

<section class="status-section" id="confirmed-findings">
  <span class="eyebrow">Confirmed findings</span>
  <p>Validated findings DWARF has written up for the Amaru team — divergences, crashes, and semantic gaps confirmed against a real node. Sourced from <code>dwarf/docs/finding-*.md</code>.</p>
  {% if confirmed %}
  {% for entry in confirmed %}
  <article class="candidate-note" id="{{ entry.slug }}">
    <span class="eyebrow">Finding</span>
    <h2 class="candidate-note__title">{{ entry.title }}</h2>
    <p class="candidate-note__status"><span class="eyebrow">Status</span> {{ entry.status }}</p>
    {% for paragraph in entry.summary.split('\n\n') if paragraph %}
    <p class="candidate-note__body">{{ paragraph }}</p>
    {% endfor %}
    <p class="candidate-note__anchor"><span class="eyebrow">Reference</span> <code>{{ entry.anchor_path }}</code></p>
  </article>
  {% endfor %}
  {% else %}
  <p class="empty-section-statement">
    No confirmed findings on record.
    <span class="empty-section-statement__cite">scanned dwarf/docs/finding-*.md, 0 files</span>
  </p>
  {% endif %}
</section>
<hr class="hairline">

<section class="status-section" id="open-candidate-findings">
  <span class="eyebrow">Open candidate findings</span>
  <p>Candidate observations are open items under investigation, not validated findings.</p>
  {% if candidates %}
  {% for entry in candidates %}
  {% include "learn/_partials/_candidate_note.j2" %}
  {% endfor %}
  {% else %}
  <p class="empty-section-statement">
    No open candidates.
    <span class="empty-section-statement__cite">scanned candidate observations, 0 files</span>
  </p>
  {% endif %}
</section>
<hr class="hairline">

<section class="status-section" id="open-carry-overs">
  <span class="eyebrow">Open carry-overs</span>
  <p>Parsed from <em>Waiting on</em> lines in the latest currentstatus document. Sections whose Waiting-on text begins with <code>No</code> (explicit non-blockers) are filtered out.</p>
  {% if carry_overs %}
  <ul class="carry-over-list">
    {% for item in carry_overs %}
    <li class="carry-over-item">
      <span class="eyebrow">{{ item.section }}</span>
      <p>{{ item.text }}</p>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty-section-statement">
    No open carry-overs.
    <span class="empty-section-statement__cite">scanned latest currentstatus-*.md for Waiting-on lines, 0 unfiltered matches</span>
  </p>
  {% endif %}
  {% if phase.anchor_path %}
  <p class="coverage-matrix__anchor">
    <span class="eyebrow">Anchor</span>
    <code>{{ phase.anchor_path }}</code>
  </p>
  {% endif %}
</section>
{% endblock %}
